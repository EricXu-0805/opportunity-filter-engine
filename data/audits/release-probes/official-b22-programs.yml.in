name: Verify Berkeley and Simplify original bookmarks on the official site
on:
  push:
    branches: [codex/verify-m212-profile-retry]
    paths: ['.github/workflows/verify-b22-program-bookmarks.yml']
permissions:
  contents: read
jobs:
  verify:
    runs-on: ubuntu-24.04
    timeout-minutes: 65
    env:
      OFE_EXPECTED_SITE_SHA: __OFFICIAL_SHA__
      OFE_PROGRAM_CHECK_MODE: __CHECK_MODE__
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - uses: actions/setup-python@v6
        with:
          python-version: '3.11'
      - run: python -m pip install --quiet playwright==1.55.0
      - run: python -u scripts/verify_deployed_b22_programs.py
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: b22-official-programs
          path: ${{ runner.temp }}/public-b22-programs.json
