name: Verify source-attributed matches and free drafts on the official site
on:
  push:
    branches: [codex/verify-m212-profile-retry]
    paths: ['.github/workflows/check-official-matching-experience.yml']
permissions:
  contents: read
jobs:
  official:
    runs-on: ubuntu-24.04
    timeout-minutes: 16
    env:
      OFE_EXPECTED_SITE_SHA: __DEPLOYED_SHA__
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - uses: actions/setup-python@v6
        with:
          python-version: '3.11'
      - run: python -m pip install --quiet playwright==1.55.0
      - name: Use one synthetic public guest, the official profile form, matching and draft controls
        run: python -u scripts/verify_public_matching_experience.py
