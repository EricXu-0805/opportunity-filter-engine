# Backend environment variables (local development).
#
# Copy this file to backend/.env and fill in real values. The .env file is
# git-ignored. Production reads these from the Render dashboard, not from
# this file.
#
# LLM provider keys — backend tries them in this order:
#   1. OPENAI_API_KEY       (direct OpenAI, gpt-4o-mini)
#   2. GEMINI_API_KEY       (Google AI Studio, gemini-2.0-flash via OpenAI-compatible endpoint)
#   3. OPENROUTER_API_KEY   (OpenRouter, google/gemini-2.0-flash-lite-001)
#
# Setting any one is enough. If none are set, chat + /explain fall back to
# structured-only responses with a "configure a key" hint.

# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...

# Operational toggles
# OFE_DISABLE_RATE_LIMIT=1     # disable per-IP rate limiting (dev only)
# ADMIN_TOKEN=                 # bearer token for /api/admin/* endpoints
# CRON_SECRET=                 # shared secret for /api/cron/* endpoints
# OFE_DEADLINE_PENALTY=0.7     # multiplier applied to score after deadline passes
