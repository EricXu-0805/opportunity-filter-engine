# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Data (keep structure, ignore large/sensitive files)
data/raw/*.html
data/raw/*.json
data/handshake_cookies.json
data/processed/embedding_cache.json
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/manual_entries/.gitkeep

# Database
*.db
*.sqlite3

# Streamlit
.streamlit/secrets.toml

# Logs
*.log
logs/

# Local daemon PIDs
*.pid

# gstack tooling (local agent audit logs / capability cache)
.gstack/

# Node / Next.js
node_modules
.next/
out/
next-env.d.ts
.vercel
.vapid-keys.local

# Supabase CLI scratch (cli-latest version cache etc.)
supabase/.temp/

# The corpus work file — assembled from data/processed/shards/ (the committed
# per-school representation; see scripts/shard_corpus.py). Never commit the
# monolith: it exceeds GitHub's 100 MB blob limit.
data/processed/opportunities.json

# root-level scrape/debug scratch must never be committed
/*.html

# OpenAlex institution roster cache. Bought by the page and re-fetchable, but
# large and per-machine — the remediation driver keeps it out of the tree so a
# resumed run costs nothing without committing tens of MB of third-party data.
data/openalex_rosters/
